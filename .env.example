# Copy to .env and fill in. scripts/dev.sh and scripts/demo.sh load it.

# Claude (Anthropic API) — required
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=32000

# Backends: local (default) or the original AWS services (s3 / bedrock)
STORAGE_BACKEND=local
RETRIEVAL_BACKEND=local

# Local storage and index; default to <repo>/data and <repo>/.chroma (use absolute paths)
# LOCAL_DATA_DIR=/absolute/path/to/data
# CHROMA_DIR=/absolute/path/to/.chroma
EMBEDDING_MODEL=BAAI/bge-m3

# Buckets (folders under LOCAL_DATA_DIR when STORAGE_BACKEND=local)
OUTPUT_BUCKET=sra-thesis-output
CLIENT_DATA_BUCKET=sra-thesis-client-data
RAW_DATA_BUCKET=sra-thesis-raw-data

# Only for RETRIEVAL_BACKEND=bedrock / STORAGE_BACKEND=s3
# AWS_REGION=eu-central-1
# KNOWLEDGE_BASE_ID=

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:3000
